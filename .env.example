PORT=3000
DATABASE_URL=postgresql://fastfood:replace-me@localhost:5432/fastfood
DATABASE_SSL=disable
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Comma-separated browser origins for a separate frontend; same-origin is default.
CORS_ORIGINS=
# Set true when the app is behind one trusted reverse proxy.
TRUST_PROXY=false

# Optional integrations; use test credentials until launch checks are complete.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GOOGLE_CLIENT_ID=
