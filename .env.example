# Copy this file to ".env" and fill in the values.

# Server port
PORT=3000

# Secret used to sign JWT tokens (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# Default admin account, created on first run
ADMIN_EMAIL=admin@fastfood.com
ADMIN_PASSWORD=change-me-before-deploying

# Razorpay TEST keys — https://dashboard.razorpay.com → Settings → API Keys
# Must start with "rzp_test_". Leave blank to disable payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Sign-In — Google Cloud Console → APIs & Services → Credentials
#   Create OAuth client ID → type "Web application"
#   Authorized JavaScript origins: http://localhost:3000
# Paste the Client ID here (ends with .apps.googleusercontent.com).
# Leave blank to disable the "Sign in with Google" button.
GOOGLE_CLIENT_ID=
